# Local SOC simulator
SOC_API_URL=http://127.0.0.1:8000
SOC_API_TIMEOUT_SECONDS=15

# LLM para el plan de acción (assistant.py). Sin esto, todo funciona igual pero sin el borrador de la IA.
# Pasarela del equipo (compatible con OpenAI). La clave está en la web de recursos de la hackatón: NO la subas a git.
LLM_PROVIDER=openai
LLM_BASE_URL=https://dcc-llm-gw.uab.cat/uabthehack/v1
LLM_API_KEY=
LLM_MODEL=ornith
# Alternativa local: LLM_PROVIDER=ollama (pip install ollama, `ollama serve`, LLM_MODEL=llama3)
# LLM_REASONING=1 deja que el modelo razone antes de responder (más lento).

# Correlación de nivel 1 (antes de la IA): alertas del mismo evento repetido dentro de esta ventana, en minutos,
# se agrupan en una sola. 0 la desactiva.
SOC_DEDUP_WINDOW_MIN=5

# Incidentes de nivel 2 (después del triaje): alertas distintas de la misma intrusión, un solo ticket (política §6).
# Ventanas entre una alerta y la siguiente que comparte la pista: indicador del atacante (días), cuenta (días),
# equipo (horas). Una pista en más de SOC_INCIDENT_HUB alertas es demasiado popular y no une.
SOC_INCIDENT_DAYS=30
SOC_INCIDENT_ACCOUNT_DAYS=14
SOC_INCIDENT_HOST_HOURS=48
SOC_INCIDENT_HUB=25
